# Copy this file to .env.local and set the values. Never commit .env.local.

# The password of the local Postgres from compose.yaml. Pick a long random value.
POSTGRES_PASSWORD=
# POSTGRES_PORT=5433

# The connection to Postgres, for example postgres://planner:<password>@127.0.0.1:5433/planner
DATABASE_URL=

# The email of the one User until sign-in ships. npm run db:migrate creates this User.
OWNER_EMAIL=
